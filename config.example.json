{
  "port": 4747,
  "plan": "PRO",
  "language": "fa",
  "permissionMode": "acceptEdits",
  "claudePath": "claude",
  "terminal": "auto",
  "dailyRunLimit": 15,
  "catchUpHours": 3,
  "vault": {
    "path": "C:\\Users\\you\\Obsidian\\My Vault",
    "name": "My Vault",
    "label": "MY VAULT",
    "dailyFolder": "",
    "runsFolder": "dashboard-runs",
    "draftsFolder": "output/drafts"
  },
  "limits": {
    "fiveHourTokens": 2400000,
    "weeklyTokens": 16300000,
    "countCacheReads": false,
    "weeklyReset": null
  },
  "models": {
    "light": "claude-haiku-4-5",
    "standard": "claude-sonnet-5-5",
    "heavy": "claude-opus-5-5"
  },
  "defaultTier": "standard",
  "domains": ["Memory", "Productivity", "Research", "Trading", "Projects"],
  "skills": [
    {
      "name": "vault-cleanup",
      "labels": { "fa": "پاک‌سازی مخزن" },
      "domain": "Memory",
      "tier": "standard",
      "schedule": "20:00",
      "days": ["thu"],
      "allowedTools": ["Read", "Glob", "Grep"]
    },
    {
      "name": "morning-brief",
      "labels": { "fa": "گزارش صبح" },
      "domain": "Productivity",
      "tier": "standard",
      "schedule": "08:00",
      "prompt": "Use the morning-brief skill. Today is {{date}}; today's daily note is {{dailyNote}}.",
      "allowedTools": [
        "Read", "Glob", "Grep", "Write", "Edit",
        "mcp__claude_ai_Google_Calendar__list_calendars",
        "mcp__claude_ai_Google_Calendar__list_events",
        "mcp__claude_ai_Gmail__search_threads",
        "mcp__claude_ai_Gmail__get_thread"
      ]
    },
    {
      "name": "inbox-brief",
      "labels": { "fa": "خلاصهٔ ایمیل" },
      "domain": "Productivity",
      "tier": "standard",
      "allowedTools": [
        "Read", "Glob", "Write",
        "mcp__claude_ai_Gmail__search_threads",
        "mcp__claude_ai_Gmail__get_thread",
        "mcp__claude_ai_Gmail__get_message",
        "mcp__claude_ai_Gmail__create_draft"
      ]
    },
    {
      "name": "weekly-review",
      "labels": { "fa": "مرور هفتگی" },
      "domain": "Productivity",
      "tier": "standard",
      "schedule": "20:30",
      "days": ["fri"],
      "allowedTools": ["Read", "Glob", "Grep", "Write", "Edit"]
    },
    {
      "name": "deep-research",
      "labels": { "fa": "تحقیق عمیق" },
      "domain": "Research",
      "tier": "standard",
      "prompt": "Use the deep-research skill on this topic:\n\n<topic here>",
      "timeoutMin": 30,
      "allowedTools": ["WebSearch", "WebFetch", "Read", "Write", "Edit", "Glob", "Grep"]
    },
    {
      "name": "market-scan",
      "labels": { "fa": "اسکن بازار" },
      "domain": "Trading",
      "tier": "standard",
      "allowedTools": ["WebSearch", "WebFetch", "Read", "Write", "Glob"]
    },
    {
      "name": "project-pulse",
      "labels": { "fa": "وضعیت پروژه‌ها" },
      "domain": "Projects",
      "tier": "light",
      "allowedTools": ["Read", "Glob", "Grep"]
    },
    {
      "name": "ingest-source",
      "labels": { "fa": "ثبت منبع جدید" },
      "domain": "Memory",
      "tier": "standard",
      "prompt": "Use the ingest-source skill for these new files in raw/:\n{{files}}",
      "allowedTools": ["Read", "Write", "Edit", "Glob", "Grep"]
    }
  ],
  "quotaGuard": { "enabled": true, "fiveHourMax": 80, "weeklyMax": 90 },
  "telegram": {
    "enabled": false,
    "botToken": "",
    "chatId": "",
    "proxy": "",
    "skills": ["morning-brief", "market-scan", "weekly-review"],
    "notifyFailures": true
  },
  "inbox": { "folders": ["output", "raw/market", "raw/research"], "days": 14 },
  "watchers": [
    { "skill": "ingest-source", "folder": "raw", "exclude": ["raw/market", "raw/research", "raw/assets"], "debounceSec": 90 }
  ],
  "cloudRoutines": [],
  "cloudSync": {
    "enabled": false,
    "repo": "https://github.com/<you>/agentic-reports",
    "intervalMin": 15,
    "branches": ["main"],
    "copy": [
      { "from": "reports/market", "to": "raw/market", "rename": "{name}-market-scan.md" },
      { "from": "reports/brief", "to": "output/briefs", "rename": "{name}-morning-brief.md" }
    ]
  },
  "integrations": []
}
